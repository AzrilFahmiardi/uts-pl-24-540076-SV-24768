# Salin menjadi .env lalu isi nilainya. Berkas .env tidak ikut di-commit.

# Laravel: buat dengan `php artisan key:generate --show` (di folder backend/)
APP_KEY=

# MySQL
DB_DATABASE=inventaris_lab
DB_USERNAME=lab_user
DB_PASSWORD=ganti-dengan-password-kuat
DB_ROOT_PASSWORD=ganti-dengan-root-password-kuat

# Akun awal untuk login (dibuat oleh seeder)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-dengan-password-admin

# Port di host
BACKEND_PORT=8000
FRONTEND_PORT=8080
